# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Resend (resend.com → API Keys). Solo se usa en el servidor, nunca llega al navegador.
RESEND_API_KEY=re_tu-api-key

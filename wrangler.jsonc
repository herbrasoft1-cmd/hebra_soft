{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hebra-soft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // "nodejs_compat_populate_process_env" es necesario porque compatibility_date es anterior al
  // 2025-04-01 (desde esa fecha viene activo por defecto). Sin esto, process.env.X solo tiene las
  // variables NEXT_PUBLIC_* (esas se hornean en el build) — las secrets de solo-runtime como
  // RESEND_API_KEY quedan undefined aunque estén cargadas en el dashboard de Cloudflare.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [{ "pattern": "hebrasoft.com", "custom_domain": true }],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hebra-soft",
    },
  ],
  // NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY no van aquí (no se versionan
  // valores reales de conexión): se configuran como "Build variables" en el dashboard de
  // Cloudflare (Workers & Pages → hebra-soft → Settings → Variables and Secrets) y, para
  // desarrollo/preview local con `wrangler`, en `.dev.vars` (ver `.dev.vars.example` y
  // `docs/DEPLOY.md`).
}
